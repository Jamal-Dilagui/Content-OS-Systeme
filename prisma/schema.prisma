// Simple Content OS — Prisma schema
// Single-page process tracker: Pinterest rotation + custom categories with daily tasks

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Pinterest accounts — rotate one per day, 30 pins each, don't repeat until all done
model PinterestAccount {
  id             String   @id @default(cuid())
  name           String
  pinsPerBatch   Int      @default(30)
  pinsCompleted  Int      @default(0)
  doneThisCycle  Boolean  @default(false)
  cycle          Int      @default(1)
  lastWorkedDate DateTime?
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
}

// Categories — Blog, Patterns, + user-created. Each has a daily target.
model Category {
  id          String   @id @default(cuid())
  name        String
  dailyTarget Int      @default(5)
  color       String   @default("violet") // violet, sky, emerald, amber, rose, cyan
  icon        String   @default("FileText")
  orderIndex  Int      @default(0)
  tasks       Task[]
  createdAt   DateTime @default(now())
}

// Tasks — belong to a category, reset daily
model Task {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  done        Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
}

// Daily log — tracks completion per day for the chart
model DailyLog {
  id              String   @id @default(cuid())
  date            DateTime // the day (midnight)
  categoryId      String?
  pinsCompleted   Int      @default(0)
  tasksCompleted  Int      @default(0)
  createdAt       DateTime @default(now())
}

// Streak / reward tracking
model Streak {
  id             String   @id @default(cuid())
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime?
  totalDays      Int      @default(0)
  rewards        Int      @default(0) // count of 100% days
  updatedAt      DateTime @updatedAt
}
